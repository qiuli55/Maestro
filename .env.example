# Maestro 配置（复制为 .env 并填入真实值；.env 已 gitignore）
#
# 必填（至少一个）：
DEEPSEEK_API_KEY=sk-your-key-here
# 可选：换 base_url（如 Kimi/Anthropic 兼容）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ====== 编排器 ======
# 拆分/汇总/闲聊用的模型
MAESTRO_MODEL=deepseek-chat
# 单 worker 执行超时上限（秒）
WORKER_TIMEOUT=600
# 沙箱审批超时（秒，默认 120）
# MAESTRO_APPROVAL_TIMEOUT=120
# 输出目录（默认 ./outputs）
# MAESTRO_OUTPUTS=F:/Maestro/outputs

# ====== 数字人闲聊 ======
# 配置 providers.json 即可（base_url + api_key_env + model）

# ====== Worker 注册 ======
# 各 worker 的 bin 路径（也可放 configs/workers.json）
# OPENCODE_BIN=E:\tools\opencode\node_modules\opencode-ai\bin\opencode.exe
# OCTO_BIN=E:\tools\octo\octo.exe
# CODEBUDDY_BIN=codebuddy
# WORKBUDDY_BIN=workbuddy-cli

# ====== MiniMax worker（可选，用于图/视频/语音/音乐生成）======
# 已通过 `mmx auth login` 持久化的无需设置；想强制传可设：
# MMX_API_KEY=sk-cp-your-key-here
# MMX_REGION=cn

# ====== OpenAI DALL-E（embedded 生成图片，可选）======
# OPENAI_API_KEY=sk-your-openai-key

# ====== SQLite（可选）======
# 默认 ./maestro.db；测试可用 ":memory:"
# MAESTRO_DB=./maestro.db

# ====== Web 服务 ======
# MAESTRO_HOST=127.0.0.1
# MAESTRO_PORT=8787

# ====== 日志（可选）======
# LOG_LEVEL=DEBUG   # 默认 INFO
# LOG_FORMAT=json   # 默认 text；容器/CI 用 json 便于收集（ELK/Loki）