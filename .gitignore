*.db
*.sqlite3
maestro.db-journal
maestro.db-wal
maestro.db-shm
# 应用日志
*.log
# 在线备份产物（backups/maestro_*.db 及残留 journal）
backups/
*.db-journal

# =============================================================================
# AI 协作工具本地状态（不入库）
# =============================================================================
# ZCode 会话/计划文件
.zcode/
# 一次性需求/冒烟用例草稿
req_sandbox_review.md
req_smoke.txt

