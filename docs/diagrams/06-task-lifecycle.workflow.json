{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Maestro 任务全生命周期",
    "subtitle": "从用户输入到结果落库：拆分 → 闸门 → 派发 → 防线 → 汇总",
    "output": "maestro-task-lifecycle.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "submit-and-split",
        "label": "提交与拆分",
        "focus": [
          "input",
          "create",
          "split",
          "ready"
        ],
        "note": "用户输入经场景路由拆分为子任务，停在人工闸门。"
      },
      {
        "id": "gate-and-dispatch",
        "label": "确认与派发",
        "focus": [
          "ready",
          "confirm",
          "dispatch",
          "guard"
        ],
        "note": "用户确认后进 running，外部 CLI 派发前过防线 1。"
      },
      {
        "id": "defense-and-approval",
        "label": "防线与审批",
        "focus": [
          "guard",
          "runcmd",
          "approval",
          "blocked"
        ],
        "note": "三档分级：白名单直跑 / 越权审批 / 灾难拒绝。"
      },
      {
        "id": "merge-and-finish",
        "label": "汇总与收尾",
        "focus": [
          "collect",
          "merge",
          "done",
          "failed"
        ],
        "note": "子任务收齐后 LLM 汇总，终态落库并推 WS。"
      }
    ]
  },
