  "cards": [
    {
      "dot": "cyan",
      "title": "拆分方式",
      "items": [
        "场景 A：按行切（多需求清单）",
        "场景 B：按段落切（长文本）",
        "场景 C：LLM 拆步骤（抽象任务）",
        "工作流：用户编排的启用卡片直通"
      ]
    },
    {
      "dot": "violet",
      "title": "人工闸门",
      "items": [
        "ready 态可整体替换子任务列表",
        "confirm=false 跳过闸门自动执行",
        "工作流模式可勾选'引用上一环节产出'"
      ]
    },
    {
      "dot": "rose",
      "title": "双层防线",
      "items": [
        "防线1 Guard：恶意 prompt 直接 block 子任务",
        "防线2 runcmd 三档：白名单直跑 / 越权审批 / 灾难拒绝",
        "审批经 WS 实时推送，120s 未决定 = timedout",
        "60 个 e2e 用例验证（tests/test_sandbox_security.py）"
      ]
    },
    {
      "dot": "emerald",
      "title": "终态语义",
      "items": [
        "瞬时故障（超时/网络/5xx）自动重试 1 次",
        "永久失败（参数错/bin 缺失）不重试避免重复计费",
        "取消是终态：协作式 cancel_requested_at 贯穿派发全程",
        "任务失败不静默：落 FAILED + 事件日志 + WS 推送"
      ]
    }
  ]
