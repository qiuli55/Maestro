  "cards": [
    {
      "dot": "cyan",
      "title": "入口层",
      "items": [
        "CLI 命令行入口",
        "Web FastAPI + WebSocket",
        "Chat 流式闲聊（历史落库 SQLite）",
        "Guard 防线 1（恶意 prompt 拦截）"
      ]
    },
    {
      "dot": "violet",
      "title": "编排层",
      "items": [
        "Orchestrator 状态机 + split / merge（结果落 SQLite）",
        "HITL 闸门（pending → ready → running）",
        "快/慢线程池（fast 拆分 / slow 执行，防饿死）",
        "外部 CLI worker 派发前过 Guard 防线 1"
      ]
    },
    {
      "dot": "emerald",
      "title": "Worker 与防线 2",
      "items": [
        "Embedded / OpenCode / Octo / WorkBuddy / CodeBuddy",
        "全部 worker 的 bin 路径来自 configs/workers.json",
        "runcmd 白名单（Windows 内建自动 cmd /c 包裹）",
        "Sandbox 越权审批流（approve / reject / timedout，WS 实时推送）",
        "SQLite 每 24h 在线备份，保留 7 份"
      ]
    },
    {
      "dot": "amber",
      "title": "LLM & 状态",
      "items": [
        "多 provider 弹性（重试 / 限流 / 熔断）——Chat 与 Embedded worker 都走它",
        "SQLite WAL 主库（任务/事件/聊天历史统一落库）",
        "WS 订阅推送（聊天 / 任务 / 审批）",
        "/metrics + /api/health/dashboard（Web 状态卡 5s 拉取）",
        "configs/ + backups/（24h 保留 7 份）"
      ]
    }
  ]
}